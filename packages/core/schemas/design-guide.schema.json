{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-harness.dev/schemas/design-guide.schema.json",
  "title": "DesignGuide",
  "description": "Closed authoring envelope for the Design Harness generation profile and optional project-contract audit policies.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tokens",
    "prohibitions",
    "signatureElement"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.2"
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "color",
        "font",
        "spacing",
        "radius"
      ],
      "properties": {
        "color": {
          "type": "object"
        },
        "font": {
          "type": "object"
        },
        "spacing": {
          "type": "object"
        },
        "radius": {
          "type": "object"
        }
      }
    },
    "prohibitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "signatureElement": {
      "type": "string",
      "minLength": 1
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "color": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ignoreSelectors"
          ],
          "properties": {
            "ignoreSelectors": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        },
        "spacing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ignoreSelectors"
          ],
          "properties": {
            "ignoreSelectors": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        },
        "fontFamily": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "additionalAllowedFamilies": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "kind"
                ],
                "properties": {
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "named",
                      "generic"
                    ]
                  }
                }
              }
            },
            "ignoreSelectors": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        },
        "typographyVariants": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxDistinctVariants"
          ],
          "properties": {
            "maxDistinctVariants": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000
            },
            "ignoreSelectors": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        },
        "paletteDiscipline": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "maxDistinctColors"
              ],
              "properties": {
                "maxDistinctColors": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5000
                },
                "maxChromaticHueFamilies": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                },
                "ignoreSelectors": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "maxChromaticHueFamilies"
              ],
              "properties": {
                "maxDistinctColors": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5000
                },
                "maxChromaticHueFamilies": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12
                },
                "ignoreSelectors": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                }
              }
            }
          ]
        },
        "densityComplexity": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "maxVisibleElements"
              ],
              "properties": {
                "maxVisibleElements": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "maxTextClusters": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20000
                },
                "ignoreSelectors": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "maxTextClusters"
              ],
              "properties": {
                "maxVisibleElements": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "maxTextClusters": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20000
                },
                "ignoreSelectors": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
